#include <winver.h>

/* 任务栏 / 资源管理器里显示的应用图标 */
IDI_SITBREAK ICON "sitbreak.ico"

/* 版本信息：任务管理器「进程」里用 FileDescription 作为友好名称 */
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "SitBreak contributors"
            VALUE "FileDescription", "起身吧 SitBreak 久坐提醒与坐姿微训练"
            VALUE "FileVersion", "1.2.0.0"
            VALUE "InternalName", "SitBreak"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "SitBreak.exe"
            VALUE "ProductName", "起身吧 SitBreak"
            VALUE "ProductVersion", "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
